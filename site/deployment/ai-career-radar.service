[Unit]
Description=Private AI career radar update API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
StateDirectory=ai-career-radar
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ai-career-radar
ExecStartPre=/usr/bin/node --dns-result-order=ipv4first --experimental-strip-types /srv/ai-career-radar/current/runtime/scripts/radar-server.mjs --refresh-once
ExecStart=/usr/bin/node --dns-result-order=ipv4first --experimental-strip-types /srv/ai-career-radar/current/runtime/scripts/radar-server.mjs
Environment=NODE_ENV=production
Environment=RADAR_FETCH_TRANSPORT=curl
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
CPUQuota=25%
TasksMax=32
Nice=10
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
